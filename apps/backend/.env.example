# Development environment values used by local backend runtime.
# Everything must be in double quotes.
NODE_ENV=development

# ==================================================================================
# Database Configuration
# ==================================================================================

# Database connection string for Prisma; adjust as needed for your local setup
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/<database>?schema=public"

# ==================================================================================
# Authentication Configuration
# ==================================================================================

# Google OAuth Credentials
# You need to set up a Google OAuth client in the Google Cloud Console and replace these values with your own credentials.
GOOGLE_CLIENT_ID="<google-oauth-client-id>"
GOOGLE_CLIENT_SECRET="<google-oauth-client-secret>"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/oauth/google/callback"

# ==================================================================================
# CORS Configuration
# ==================================================================================

# This should match the URL of your frontend development server to allow API requests from the frontend to
CORS_ORIGIN="http://localhost:5173"

# ==================================================================================
# Session Configuration
# ==================================================================================

# Required for signing session cookies; must be a long random string in every environment
# It can literally be anything, but it should be kept secret in production, hence it being here.
SESSION_SECRET="<long-random-string>"


# ==================================================================================
# Mailer Configuration
# ==================================================================================

# The email address that will appear in the "From" field of sent emails
MAILER_EMAIL="<from-address>"
# SMTP configuration for sending emails; I used AWS SES but can be adapted for other providers
SMTP_HOST="<smtp-host>"
# SMTP port (587 is common for TLS, 25 is also used but often blocked by ISPs, 2587 is an alternative for TLS if 587 is blocked)
SMTP_PORT=587             # or 25 / 2587 is network blocks
SMTP_SECURE=false        # set to false if using 587
# SMTP credentials (if your provider requires authentication)
SMTP_USER="<smtp-username>"
SMTP_PASS="<smtp-password>"
FRTONTEND_URL="http://localhost:5173"
## Set to true to allow logging emails to console in development when SMTP is not configured
MAILER_ALLOW_LOG_FALLBACK=false

# ==================================================================================
# Firebase Admin SDK Configuration
# ==================================================================================

#Firebase Admin SDK (for storing user profile pictures in Firebase Storage)
FIREBASE_PROJECT_ID="<firebase-project-id>"
FIREBASE_CLIENT_EMAIL="<firebase-service-email>"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET="gs://<bucket-name>"