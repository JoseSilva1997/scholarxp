generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id              Int           @id @default(autoincrement())
  name            String
  lmsPlatform     String        @map("lms_platform")
  lmsIssuerUrl    String        @map("lms_issuer_url")
  lmsClientId     String        @map("lms_client_id")
  lmsDeploymentId String        @map("lms_deployment_id")
  jwksUrl         String        @map("jwks_url")
  authTokenUrl    String        @map("auth_token_url")
  authRequestUrl  String        @map("auth_request_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  ltiIdentities   LtiIdentity[]
  modules         Module[]

  @@unique([lmsIssuerUrl, lmsClientId, lmsDeploymentId])
  @@map("institutions")
}

model LtiIdentity {
  id            Int         @id @default(autoincrement())
  institutionId Int         @map("institution_id")
  userId        Int         @map("user_id")
  ltiUserId     String      @map("lti_user_id")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lti_identity")
}

model User {
  id                      Int                      @id @default(autoincrement())
  firstName               String                   @map("first_name")
  lastName                String                   @map("last_name")
  email                   String?                  @unique
  profilePictureUrl       String                   @default("default-profile-pic.png") @map("profile_picture_url")
  globalRole              GlobalRole               @default(pending) @map("global_role")
  isVerified              Boolean                  @default(false)
  createdAt               DateTime                 @default(now()) @map("created_at")
  authIdentities          AuthIdentity[]
  password                UserPassword?
  /// Keeps track of one-time email verification codes so signup flows can mark users verified without losing auditability.
  emailVerificationTokens EmailVerificationToken[]
  createdModules          Module[]
  createdInvites          ModuleInvite[]
  avatars                 Avatar[]
  dailyQuests             DailyQuest[]
  ltiIdentities           LtiIdentity[]
  userProgress            ModuleUnitUserProgress[]
  practiceSessions        PracticeSession[]
  questionAttempts        QuestionAttempt[]
  userModules             UserModule[]

  @@map("users")
}

model Avatar {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  level      Int
  currentExp Int      @map("current_exp")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("avatars")
}

model Module {
  id               Int               @id @default(autoincrement())
  institutionId    Int?              @map("institution_id")
  ltiContextId     String?           @map("lti_context_id")
  resourceLinkId   String?           @map("resource_link_id")
  variantContext   String?           @map("variant_context")
  title            String
  description      String?
  createdByUserId  Int?              @map("created_by_user_id")
  createdAt        DateTime          @default(now()) @map("created_at")
  institution      Institution?      @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy        User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  dailyQuests      DailyQuest[]
  invites          ModuleInvite[]
  moduleUnits      ModuleUnit[]
  practiceSessions PracticeSession[]
  userModules      UserModule[]

  @@unique([institutionId, ltiContextId])
  @@unique([institutionId, resourceLinkId])
  @@map("modules")
}

model UserModule {
  id              Int              @id @default(autoincrement())
  moduleId        Int              @map("module_id")
  userId          Int              @map("user_id")
  roleInModule    String           @map("role_in_module")
  userModuleLevel Int              @map("user_module_level")
  currentExp      Int              @map("current_exp")
  enrolledVia     EnrollmentSource @default(invite) @map("enrolled_via")
  createdAt       DateTime         @default(now()) @map("created_at")
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId])
  @@map("user_modules")
}

model DailyQuest {
  id           Int        @id @default(autoincrement())
  moduleId     Int        @map("module_id")
  moduleUnitId Int?       @map("module_unit_id")
  userId       Int        @map("user_id")
  type         String
  expGranted   Int        @map("exp_granted")
  isCompleted  Boolean    @default(false) @map("is_completed")
  // UTC calendar day anchor used for "today" reads and quest history grouping.
  questDateUtc DateTime   @db.Date @map("quest_date_utc")
  generatedAt  DateTime   @default(now()) @map("generated_at")
  // Nullable because incomplete quests do not have a completion timestamp.
  completedAt  DateTime?  @map("completed_at")
  module       Module      @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  // Composite relation enforces that any targeted lesson belongs to the same module as the quest.
  moduleUnit   ModuleUnit? @relation(fields: [moduleUnitId, moduleId], references: [id, moduleId], onDelete: NoAction)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Supports user quest-history reads that page by UTC day and keep row ordering stable.
  @@index([userId, questDateUtc(sort: Desc), id], map: "daily_quests_user_id_quest_date_utc_id_idx")
  @@unique([userId, moduleId, type, questDateUtc])
  @@map("daily_quests")
}

model PracticeSession {
  id               String            @id @default(uuid()) @db.Uuid
  moduleId         Int?              @map("module_id")
  userId           Int?              @map("user_id")
  startTime        DateTime          @map("start_time")
  endTime          DateTime?         @map("end_time")
  module           Module?           @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  questionAttempts QuestionAttempt[]

  @@map("practice_sessions")
}

model ModuleUnit {
  id               Int                       @id @default(autoincrement())
  moduleId         Int?                      @map("module_id")
  variantContext   String                    @map("variant_context")
  title            String
  questionCount    Int                       @map("question_count")
  status           ModuleUnitStatus          @default(draft)
  sortOrder        Int                       @map("sort_order")
  createdAt        DateTime                  @default(now()) @map("created_at")
  module           Module?                   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  questionGroups   ModuleUnitQuestionGroup[]
  userProgress     ModuleUnitUserProgress[]
  questionAttempts QuestionAttempt[]
  questionUnits    QuestionUnit[]
  dailyQuests      DailyQuest[]

  // Supports composite FK from daily quests so module-unit targets cannot cross modules.
  @@unique([id, moduleId])
  @@map("module_unit")
}

model ModuleUnitQuestionGroup {
  id            Int            @id @default(autoincrement())
  moduleUnitId  Int            @map("module_unit_id")
  name          String
  sortOrder     Int            @map("sort_order")
  // Group archive flag lets us hide groups from future authoring/assessment without deleting attempt history.
  isArchived    Boolean        @default(false) @map("is_archived")
  moduleUnit    ModuleUnit     @relation(fields: [moduleUnitId], references: [id], onDelete: Cascade)
  questionUnits QuestionUnit[]

  // Keep a non-unique lookup index in Prisma; active-only uniqueness is enforced via a partial unique index in SQL migration.
  @@index([moduleUnitId, name])
  @@map("module_unit_question_groups")
}

model ModuleUnitUserProgress {
  id                  Int        @id @default(autoincrement())
  moduleUnitId        Int        @map("module_unit_id")
  studentId           Int?       @map("student_id")
  currentMasteryScore Float      @map("current_mastery_score")
  isCompleted         Boolean    @default(false) @map("is_completed")
  noOfCorrectAnswers  Int        @map("no_of_correct_answers")
  completedAt         DateTime?  @map("completed_at")
  lastPracticedAt     DateTime?  @map("last_practiced_at")
  moduleUnit          ModuleUnit @relation(fields: [moduleUnitId], references: [id], onDelete: Cascade)
  student             User?      @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // One progress aggregate per student per module unit keeps upserts deterministic from practice attempts.
  @@unique([moduleUnitId, studentId])
  @@map("module_unit_user_progress")
}

model QuestionUnit {
  id              Int                      @id @default(autoincrement())
  moduleUnitId    Int?                     @map("module_unit_id")
  questionGroupId Int?                     @map("question_group_id")
  title           String
  // Question archive flag allows post-live removals from future sets while preserving historical attempts.
  isArchived      Boolean                  @default(false) @map("is_archived")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  moduleUnit      ModuleUnit?              @relation(fields: [moduleUnitId], references: [id], onDelete: Cascade)
  questionGroup   ModuleUnitQuestionGroup? @relation(fields: [questionGroupId], references: [id], onDelete: SetNull)
  attempts        QuestionAttempt[]
  contents        QuestionContent[]
  variants        QuestionVariant[]

  @@map("question_unit")
}

model QuestionContent {
  id               Int               @id @default(autoincrement())
  type             String
  questionUnitId   Int               @map("question_unit_id")
  isCore           Boolean           @default(false) @map("is_core")
  questionStem     String            @map("question_stem")
  questionData     Json              @map("question_data")
  hint             String?
  difficultyScore  Float             @map("difficulty_score")
  source           String
  isArchived       Boolean           @default(false) @map("is_archived")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  questionUnit     QuestionUnit      @relation(fields: [questionUnitId], references: [id], onDelete: Cascade)
  questionAttempts QuestionAttempt[]
  variantMetadata  QuestionVariant?

  @@map("question_content")
}

model QuestionVariant {
  id             Int             @id @default(autoincrement())
  questionUnitId Int             @map("question_unit_id")
  contentId      Int             @unique @map("content_id")
  variantLabel   String          @map("variant_label")
  content        QuestionContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  questionUnit   QuestionUnit    @relation(fields: [questionUnitId], references: [id], onDelete: Cascade)

  @@map("question_variant")
}

model QuestionAttempt {
  id            Int              @id @default(autoincrement())
  sessionId     String?          @db.Uuid @map("session_id")
  moduleUnitId  Int?             @map("module_unit_id")
  studentId     Int?             @map("student_id")
  questionId    Int              @map("question_id")
  contentId     Int              @map("content_id")
  practiceMode  String           @map("practice_mode")
  isCorrect     Boolean          @map("is_correct")
  timeTakenMs   Int              @map("time_taken_ms")
  hintsUsed     Int              @default(0) @map("hints_used")
  studentAnswer Json             @map("student_answer")
  attemptedAt   DateTime         @default(now()) @map("attempted_at")
  // Session linkage keeps attempts grouped under one practice run without making the relation mandatory for legacy rows.
  session       PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  content       QuestionContent  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  moduleUnit    ModuleUnit?      @relation(fields: [moduleUnitId], references: [id], onDelete: SetNull)
  question      QuestionUnit     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student       User?            @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Supports first-correct lookups used by unit-progress aggregation on submit.
  @@index([moduleUnitId, studentId, questionId, isCorrect])
  // Supports latest-attempt room hydration filtered by unit/student/question/content.
  @@index([moduleUnitId, studentId, questionId, contentId, attemptedAt, id])
  @@index([sessionId])
  @@map("question_attempts")
}

model AuthIdentity {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("auth_identity")
}

/// Stores the short-lived codes that prove control of an email address without keeping them on the users table.
model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  token      String    @unique
  reason     String    @default("signup")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

model UserPassword {
  userId       Int      @id @map("user_id")
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_password")
}

model ModuleInvite {
  id              Int        @id @default(autoincrement())
  moduleId        Int        @map("module_id")
  createdByUserId Int        @map("created_by_user_id")
  type            InviteType
  tokenHash       String     @map("token_hash")
  emailLock       String?    @map("email_lock")
  maxUses         Int?       @map("max_uses")
  uses            Int        @default(0)
  expiresAt       DateTime?  @map("expires_at")
  revokedAt       DateTime?  @map("revoked_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  module          Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy       User       @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@map("module_invites")
}

enum GlobalRole {
  pending
  admin
  institution_admin
  teacher
  student
}

enum AuthProvider {
  google
  microsoft
  local
  lti
}

enum InviteType {
  link
  code
}

enum EnrollmentSource {
  lti
  invite
  admin
  csv
}

enum ModuleUnitStatus {
  draft
  locked
  live
  archived
}
