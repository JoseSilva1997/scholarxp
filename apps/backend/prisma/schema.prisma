generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Institution {
  id              Int           @id @default(autoincrement())
  name            String
  lmsPlatform     String        @map("lms_platform")
  lmsIssuerUrl    String        @map("lms_issuer_url")
  lmsClientId     String        @map("lms_client_id")
  lmsDeploymentId String        @map("lms_deployment_id")
  jwksUrl         String        @map("jwks_url")
  authTokenUrl    String        @map("auth_token_url")
  authRequestUrl  String        @map("auth_request_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  ltiIdentities   LtiIdentity[]
  modules         Module[]

  @@unique([lmsIssuerUrl, lmsClientId, lmsDeploymentId])
  @@map("institutions")
}

model LtiIdentity {
  id            Int         @id @default(autoincrement())
  institutionId Int         @map("institution_id")
  userId        Int         @map("user_id")
  ltiUserId     String      @map("lti_user_id")
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lti_identity")
}

model User {
  id                      Int                      @id @default(autoincrement())
  firstName               String                   @map("first_name")
  lastName                String                   @map("last_name")
  email                   String?                  @unique
  profilePictureUrl       String                   @default("default-profile-pic.png") @map("profile_picture_url")
  globalRole              GlobalRole               @default(pending) @map("global_role")
  isVerified              Boolean                  @default(false)
  createdAt               DateTime                 @default(now()) @map("created_at")
  authIdentities          AuthIdentity[]
  password                UserPassword?
  /// Keeps track of one-time email verification codes so signup flows can mark users verified without losing auditability.
  emailVerificationTokens EmailVerificationToken[]
  createdModules          Module[]
  createdInvites          ModuleInvite[]
  avatars                 Avatar[]
  dailyQuests             DailyQuest[]
  ltiIdentities           LtiIdentity[]
  // One daily-practice set per module/day is generated for each learner and linked here for reads and cleanup.
  dailyPracticeSets       DailyPracticeSet[]
  // Adaptive state is tracked per learner per question so selection can read from persisted memory state.
  studentQuestionStates   StudentQuestionState[]
  userProgress            ModuleUnitUserProgress[]
  practiceSessions        PracticeSession[]
  questionAttempts        QuestionAttempt[]
  userModules             UserModule[]
  expLedgerEntries        ExpLedger[]

  @@map("users")
}

model Avatar {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  // Canonical lifetime account XP used for non-linear level-curve calculations.
  totalExp  Int      @default(0) @map("total_exp")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("avatars")
}

model Module {
  id                    Int                    @id @default(autoincrement())
  institutionId         Int?                   @map("institution_id")
  ltiContextId          String?                @map("lti_context_id")
  resourceLinkId        String?                @map("resource_link_id")
  variantContext        String?                @map("variant_context")
  title                 String
  description           String?
  createdByUserId       Int?                   @map("created_by_user_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  institution           Institution?           @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  createdBy             User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  // Module-scoped daily-practice sets stay tied to the module because daily practice is never global.
  dailyPracticeSets     DailyPracticeSet[]
  dailyQuests           DailyQuest[]
  invites               ModuleInvite[]
  moduleUnits           ModuleUnit[]
  practiceSessions      PracticeSession[]
  // Question state stores denormalized module ownership to keep module-scoped candidate queries efficient.
  studentQuestionStates StudentQuestionState[]
  userModules           UserModule[]
  expLedgerEntries      ExpLedger[]

  @@unique([institutionId, ltiContextId])
  @@unique([institutionId, resourceLinkId])
  @@map("modules")
}

model UserModule {
  id              Int              @id @default(autoincrement())
  moduleId        Int              @map("module_id")
  userId          Int              @map("user_id")
  roleInModule    String           @map("role_in_module")
  userModuleLevel Int              @map("user_module_level")
  currentExp      Int              @map("current_exp")
  enrolledVia     EnrollmentSource @default(invite) @map("enrolled_via")
  createdAt       DateTime         @default(now()) @map("created_at")
  module          Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([moduleId, userId])
  @@map("user_modules")
}

model DailyQuest {
  id               Int         @id @default(autoincrement())
  moduleId         Int?        @map("module_id")
  moduleUnitId     Int?        @map("module_unit_id")
  userId           Int         @map("user_id")
  type             String
  expGranted       Int         @map("exp_granted")
  isCompleted      Boolean     @default(false) @map("is_completed")
  // UTC calendar day anchor used for "today" reads and quest history grouping.
  questDateUtc     DateTime    @map("quest_date_utc") @db.Date
  generatedAt      DateTime    @default(now()) @map("generated_at")
  // Nullable because incomplete quests do not have a completion timestamp.
  completedAt      DateTime?   @map("completed_at")
  module           Module?     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  // Composite relation enforces that any targeted lesson belongs to the same module as the quest.
  moduleUnit       ModuleUnit? @relation(fields: [moduleUnitId, moduleId], references: [id, moduleId], onDelete: NoAction)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  expLedgerEntries ExpLedger[]

  // Uniqueness is enforced via partial unique indexes in SQL migrations so global (moduleId null)
  // and module-scoped quests can each enforce the correct deduplication rules.
  // Supports user quest-history reads that page by UTC day and keep row ordering stable.
  @@index([userId, questDateUtc(sort: Desc), id], map: "daily_quests_user_id_quest_date_utc_id_idx")
  @@map("daily_quests")
}

model ExpLedger {
  id              String           @id @default(uuid()) @db.Uuid
  userId          Int              @map("user_id")
  moduleId        Int?             @map("module_id")
  moduleUnitId    Int?             @map("module_unit_id")
  sessionId       String?          @map("session_id") @db.Uuid
  questId         Int?             @map("quest_id")
  // Idempotency key prevents duplicate rewards when submit retries race.
  idempotencyKey  String           @unique @map("idempotency_key")
  eventType       String           @map("event_type")
  awardedExp      Int              @map("awarded_exp")
  eventTimestamp  DateTime         @default(now()) @map("event_timestamp")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          Module?          @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  moduleUnit      ModuleUnit?      @relation(fields: [moduleUnitId], references: [id], onDelete: SetNull)
  practiceSession PracticeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  quest           DailyQuest?      @relation(fields: [questId], references: [id], onDelete: SetNull)

  // Supports chronological ledger reads and deterministic pagination for account history views.
  @@index([userId, eventTimestamp(sort: Desc), id], map: "exp_ledger_user_id_event_timestamp_id_idx")
  // Enables fast checks for idempotent session- and quest-scoped reward events.
  @@index([sessionId, questId, eventType], map: "exp_ledger_scope_event_type_idx")
  @@map("exp_ledger")
}

model PracticeSession {
  id               String            @id @default(uuid()) @db.Uuid
  moduleId         Int?              @map("module_id")
  userId           Int?              @map("user_id")
  // Keep this as string so shared contracts own allowed values without DB enum migrations for each value change.
  sessionType      String            @default("practice_room") @map("session_type")
  startTime        DateTime          @map("start_time")
  endTime          DateTime?         @map("end_time")
  module           Module?           @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  questionAttempts QuestionAttempt[]
  expLedgerEntries ExpLedger[]

  @@map("practice_sessions")
}

model ModuleUnit {
  id                    Int                       @id @default(autoincrement())
  moduleId              Int?                      @map("module_id")
  variantContext        String                    @map("variant_context")
  title                 String
  questionCount         Int                       @map("question_count")
  status                ModuleUnitStatus          @default(draft)
  sortOrder             Int                       @map("sort_order")
  createdAt             DateTime                  @default(now()) @map("created_at")
  module                Module?                   @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  // Persisted daily-practice items keep their lesson linkage so interleaving can avoid same-lesson adjacency.
  dailyPracticeSetItems DailyPracticeSetItem[]
  questionGroups        ModuleUnitQuestionGroup[]
  // Per-question adaptive state keeps unit linkage denormalized for fast selector bucket queries.
  studentQuestionStates StudentQuestionState[]
  userProgress          ModuleUnitUserProgress[]
  questionAttempts      QuestionAttempt[]
  questionUnits         QuestionUnit[]
  dailyQuests           DailyQuest[]
  expLedgerEntries      ExpLedger[]

  // Supports composite FK from daily quests so module-unit targets cannot cross modules.
  @@unique([id, moduleId])
  @@map("module_unit")
}

model ModuleUnitQuestionGroup {
  id            Int            @id @default(autoincrement())
  moduleUnitId  Int            @map("module_unit_id")
  name          String
  sortOrder     Int            @map("sort_order")
  // Group archive flag lets us hide groups from future authoring/assessment without deleting attempt history.
  isArchived    Boolean        @default(false) @map("is_archived")
  moduleUnit    ModuleUnit     @relation(fields: [moduleUnitId], references: [id], onDelete: Cascade)
  questionUnits QuestionUnit[]

  // Keep a non-unique lookup index in Prisma; active-only uniqueness is enforced via a partial unique index in SQL migration.
  @@index([moduleUnitId, name])
  @@map("module_unit_question_groups")
}

model ModuleUnitUserProgress {
  id                  Int        @id @default(autoincrement())
  moduleUnitId        Int        @map("module_unit_id")
  studentId           Int?       @map("student_id")
  currentMasteryScore Float      @map("current_mastery_score")
  isCompleted         Boolean    @default(false) @map("is_completed")
  noOfCorrectAnswers  Int        @map("no_of_correct_answers")
  completedAt         DateTime?  @map("completed_at")
  lastPracticedAt     DateTime?  @map("last_practiced_at")
  moduleUnit          ModuleUnit @relation(fields: [moduleUnitId], references: [id], onDelete: Cascade)
  student             User?      @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // One progress aggregate per student per module unit keeps upserts deterministic from practice attempts.
  @@unique([moduleUnitId, studentId])
  @@map("module_unit_user_progress")
}

model QuestionUnit {
  id                    Int                      @id @default(autoincrement())
  moduleUnitId          Int?                     @map("module_unit_id")
  questionGroupId       Int?                     @map("question_group_id")
  title                 String
  // Question archive flag allows post-live removals from future sets while preserving historical attempts.
  isArchived            Boolean                  @default(false) @map("is_archived")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  moduleUnit            ModuleUnit?              @relation(fields: [moduleUnitId], references: [id], onDelete: Cascade)
  questionGroup         ModuleUnitQuestionGroup? @relation(fields: [questionGroupId], references: [id], onDelete: SetNull)
  attempts              QuestionAttempt[]
  contents              QuestionContent[]
  // Daily-practice set membership is stored at question-unit granularity because selection happens per question.
  dailyPracticeSetItems DailyPracticeSetItem[]
  // Learner review state is also question-scoped because FSRS schedules one item at a time.
  studentQuestionStates StudentQuestionState[]
  variants              QuestionVariant[]

  @@map("question_unit")
}

model StudentQuestionState {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             Int          @map("user_id")
  moduleId           Int          @map("module_id")
  moduleUnitId       Int          @map("module_unit_id")
  questionUnitId     Int          @map("question_unit_id")
  // Store card state as a string so FSRS scheduling semantics can evolve without enum migrations.
  fsrsState          String       @map("fsrs_state")
  fsrsDifficulty     Float        @map("fsrs_difficulty")
  fsrsStability      Float        @map("fsrs_stability")
  fsrsDueAt          DateTime     @map("fsrs_due_at")
  fsrsLastReviewedAt DateTime?    @map("fsrs_last_reviewed_at")
  reviewCount        Int          @default(0) @map("review_count")
  lapseCount         Int          @default(0) @map("lapse_count")
  // Nullable because unseen questions do not have a grade until their first review encounter resolves.
  lastGrade          String?      @map("last_grade")
  lastSeenAt         DateTime?    @map("last_seen_at")
  lastCorrectAt      DateTime?    @map("last_correct_at")
  recentAvgTimeMs    Int?         @map("recent_avg_time_ms")
  firstSeenAt        DateTime?    @map("first_seen_at")
  algorithmVersion   String       @default("fsrs_v1") @map("algorithm_version")
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  module             Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleUnit         ModuleUnit   @relation(fields: [moduleUnitId], references: [id], onDelete: Cascade)
  questionUnit       QuestionUnit @relation(fields: [questionUnitId], references: [id], onDelete: Cascade)

  // One adaptive state row per learner/question keeps FSRS updates deterministic.
  @@unique([userId, questionUnitId], map: "student_question_state_user_id_question_unit_id_key")
  // Selector queries need fast access to due questions within a module for one learner.
  @@index([userId, moduleId, fsrsDueAt, questionUnitId], map: "student_question_state_due_lookup_idx")
  // Interleaving and fallback quotas often need lesson-scoped reads inside the same module.
  @@index([userId, moduleId, moduleUnitId], map: "student_question_state_module_unit_lookup_idx")
  @@map("student_question_state")
}

model DailyPracticeSet {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           Int                    @map("user_id")
  moduleId         Int                    @map("module_id")
  // UTC calendar day anchor keeps one stable set per learner per module per day.
  practiceDateUtc  DateTime               @map("practice_date_utc") @db.Date
  generatedAt      DateTime               @default(now()) @map("generated_at")
  completedAt      DateTime?              @map("completed_at")
  // Keep the algorithm version with the snapshot so future tuning does not make old sets ambiguous.
  algorithmVersion String                 @default("fsrs_v1") @map("algorithm_version")
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module           Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  items            DailyPracticeSetItem[]

  // One stable snapshot per learner/module/day avoids reshuffling the set across refreshes.
  @@unique([userId, moduleId, practiceDateUtc], map: "daily_practice_set_user_module_day_key")
  // Supports "today" lookup and recent-history pagination without scanning old rows.
  @@index([userId, moduleId, practiceDateUtc(sort: Desc)], map: "daily_practice_set_user_module_day_idx")
  @@map("daily_practice_sets")
}

model DailyPracticeSetItem {
  id                 String           @id @default(uuid()) @db.Uuid
  dailyPracticeSetId String           @map("daily_practice_set_id") @db.Uuid
  questionUnitId     Int              @map("question_unit_id")
  // Persist the displayed content so daily-practice refreshes never reshuffle core-vs-variant presentation within the same day.
  questionContentId  Int              @map("question_content_id")
  moduleUnitId       Int              @map("module_unit_id")
  position           Int
  // Reason stays string-backed so selector heuristics can become more specific without schema churn.
  selectionReason    String           @map("selection_reason")
  selectionScore     Float            @map("selection_score")
  sourceBucket       String           @map("source_bucket")
  dailyPracticeSet   DailyPracticeSet @relation(fields: [dailyPracticeSetId], references: [id], onDelete: Cascade)
  questionContent    QuestionContent  @relation(fields: [questionContentId], references: [id], onDelete: Restrict)
  questionUnit       QuestionUnit     @relation(fields: [questionUnitId], references: [id], onDelete: Cascade)
  moduleUnit         ModuleUnit       @relation(fields: [moduleUnitId], references: [id], onDelete: Cascade)

  // Keep one row per question in a set so submit flow and progress counts remain unambiguous.
  @@unique([dailyPracticeSetId, questionUnitId], map: "daily_practice_set_item_question_key")
  // Position is persisted so refreshes preserve deterministic interleaving order.
  @@unique([dailyPracticeSetId, position], map: "daily_practice_set_item_position_key")
  @@index([questionContentId], map: "daily_practice_set_item_content_lookup_idx")
  @@index([moduleUnitId, sourceBucket], map: "daily_practice_set_item_bucket_lookup_idx")
  @@map("daily_practice_set_items")
}

model QuestionContent {
  id               Int               @id @default(autoincrement())
  type             String
  questionUnitId   Int               @map("question_unit_id")
  isCore           Boolean           @default(false) @map("is_core")
  questionStem     String            @map("question_stem")
  questionData     Json              @map("question_data")
  hint             String?
  difficultyScore  Float             @map("difficulty_score")
  source           String
  isArchived       Boolean           @default(false) @map("is_archived")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  questionUnit     QuestionUnit      @relation(fields: [questionUnitId], references: [id], onDelete: Cascade)
  // Daily-practice items pin the exact content shown so variant rotation stays stable across refreshes.
  dailyPracticeSetItems DailyPracticeSetItem[]
  questionAttempts QuestionAttempt[]
  variantMetadata  QuestionVariant?

  @@map("question_content")
}

model QuestionVariant {
  id             Int             @id @default(autoincrement())
  questionUnitId Int             @map("question_unit_id")
  contentId      Int             @unique @map("content_id")
  variantLabel   String          @map("variant_label")
  content        QuestionContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  questionUnit   QuestionUnit    @relation(fields: [questionUnitId], references: [id], onDelete: Cascade)

  @@map("question_variant")
}

model QuestionAttempt {
  id            Int             @id @default(autoincrement())
  // Session id is required so every attempt has canonical session context for analytics and policy checks.
  sessionId     String          @map("session_id") @db.Uuid
  moduleUnitId  Int?            @map("module_unit_id")
  studentId     Int?            @map("student_id")
  questionId    Int             @map("question_id")
  contentId     Int             @map("content_id")
  isCorrect     Boolean         @map("is_correct")
  timeTakenMs   Int             @map("time_taken_ms")
  hintsUsed     Int             @default(0) @map("hints_used")
  studentAnswer Json            @map("student_answer")
  attemptedAt   DateTime        @default(now()) @map("attempted_at")
  // Required relation ensures deletes are blocked when attempts exist, preserving attempt history integrity.
  session       PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  content       QuestionContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  moduleUnit    ModuleUnit?     @relation(fields: [moduleUnitId], references: [id], onDelete: SetNull)
  question      QuestionUnit    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student       User?           @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Supports first-correct lookups used by unit-progress aggregation on submit.
  @@index([moduleUnitId, studentId, questionId, isCorrect])
  // Supports latest-attempt room hydration filtered by unit/student/question/content.
  @@index([moduleUnitId, studentId, questionId, contentId, attemptedAt, id])
  @@index([sessionId])
  @@map("question_attempts")
}

model AuthIdentity {
  id             Int          @id @default(autoincrement())
  userId         Int          @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("auth_identity")
}

/// Stores the short-lived codes that prove control of an email address without keeping them on the users table.
model EmailVerificationToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  token      String    @unique
  reason     String    @default("signup")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

model UserPassword {
  userId       Int      @id @map("user_id")
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_password")
}

model ModuleInvite {
  id              Int        @id @default(autoincrement())
  moduleId        Int        @map("module_id")
  createdByUserId Int        @map("created_by_user_id")
  type            InviteType
  tokenHash       String     @map("token_hash")
  emailLock       String?    @map("email_lock")
  maxUses         Int?       @map("max_uses")
  uses            Int        @default(0)
  expiresAt       DateTime?  @map("expires_at")
  revokedAt       DateTime?  @map("revoked_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  module          Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdBy       User       @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@map("module_invites")
}

enum GlobalRole {
  pending
  admin
  institution_admin
  teacher
  student
}

enum AuthProvider {
  google
  microsoft
  local
  lti
}

enum InviteType {
  link
  code
}

enum EnrollmentSource {
  lti
  invite
  admin
  csv
}

enum ModuleUnitStatus {
  draft
  locked
  live
  archived
}
